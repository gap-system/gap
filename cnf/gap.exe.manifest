<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Makes UTF-8 the code page of the gap.exe process (Windows 10 1903 and
     later), so that the kernel's file names, arguments and environment are
     UTF-8 rather than in the system's legacy code page. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
