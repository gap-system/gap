#############################################################################
##
##  This file is part of GAP, a system for computational discrete algebra.
##
##  Copyright of GAP belongs to its developers, whose names are too numerous
##  to list here. Please refer to the COPYRIGHT file for details.
##
##  SPDX-License-Identifier: GPL-2.0-or-later
##
##  Randomized correctness test of the partition backtrack in symmetric
##  groups: conjugacy and normalizers of subgroups, centralizers and
##  conjugacy of elements and pairs of elements, SubgroupProperty and
##  ElementProperty. Every answer is checked to be valid (a conjugator
##  found conjugates, the generators of a centralizer centralize) and,
##  up to degree 7, against brute force over all elements of the symmetric
##  group. The symmetric group acts on [ o + 1 .. o + n ] to also cover
##  domains not starting at 1.
##
##    gap -q -A benchmark/pbt/fuzz.g
##    gap -q -A -c 'degs:=[8..10];; seeds:=[1..40];;' benchmark/pbt/fuzz.g
##
##  Prints each failure and a summary, and exits with code 1 on failures.
##

if not IsBound( degs )  then  degs := [ 2 .. 7 ];     fi;
if not IsBound( offs )  then  offs := [ 0, 3 ];       fi;
if not IsBound( seeds )  then  seeds := [ 1 .. 20 ];  fi;

FUZZ_failures := 0;
FUZZ_tests := 0;

# A random subgroup of the symmetric group on <dom>, of one of four kinds:
#   0  generated by one or two random elements, usually the whole group
#   1  generated by random elements moving only an initial part of <dom>
#   2  a random group from the library of transitive groups
#   3  a direct product of two symmetric groups on parts of <dom>
FUZZ_RandomSubgroup := function( dom, kind )
    local   n,  k,  gens;

    n := Length( dom );
    if kind = 0  then
        return Group( List( [ 1 .. Random( [ 1, 2 ] ) ],
                            i -> Random( SymmetricGroup( dom ) ) ), () );
    elif kind = 1  then
        k := Random( [ 1 .. n ] );
        return Group( List( [ 1 .. Random( [ 1, 2 ] ) ],
                   i -> Random( SymmetricGroup( dom{ [ 1 .. k ] } ) ) ), () );
    elif kind = 2  and  n >= 2  and  n <= 30
         and  LoadPackage( "transgrp", false ) = true  then
        k := Random( [ 1 .. NrTransitiveGroups( n ) ] );
        return TransitiveGroup( n, k ) ^ MappingPermListList( [ 1 .. n ], dom );
    else
        k := Random( [ 0 .. n ] );
        gens := [  ];
        if k >= 2  then
            Add( gens, Random( SymmetricGroup( dom{ [ 1 .. k ] } ) ) );
        fi;
        if n - k >= 2  then
            Add( gens, Random( SymmetricGroup( dom{ [ k + 1 .. n ] } ) ) );
        fi;
        return Group( gens, () );
    fi;
end;

# Records one test: <valid> says whether the answer passed its check,
# <value> is what the answer determines (an order, or whether something was
# found), and <expected> is that value computed by brute force, or fail.
FUZZ_Check := function( tag, name, valid, value, expected )
    FUZZ_tests := FUZZ_tests + 1;
    if not valid  then
        FUZZ_failures := FUZZ_failures + 1;
        Print( tag, " ", name, ": invalid answer\n" );
    elif expected <> fail  and  value <> expected  then
        FUZZ_failures := FUZZ_failures + 1;
        Print( tag, " ", name, ": got ", value, ", brute force gives ",
               expected, "\n" );
    fi;
end;

# one round: random inputs on [ o + 1 .. o + n ] from seed <s>
FUZZ_Round := function( n, o, s )
    local   tag,  dom,  sym,  triv,  sub1,  sub2,  c,  x,  y,  z,  A,  B,
            all,  oracle,  r,  N,  C,  S;

    Reset( GlobalMersenneTwister, 100000 * n + 1000 * o + s );
    Reset( GlobalRandomSource, 100000 * n + 1000 * o + s );
    tag := Concatenation( "n=", String( n ), " o=", String( o ),
                          " s=", String( s ) );
    dom := [ o + 1 .. o + n ];
    sym := SymmetricGroup( dom );
    triv := TrivialSubgroup( sym );
    sub1 := FUZZ_RandomSubgroup( dom, s mod 4 );
    c := Random( sym );
    if s mod 3 = 0  then  sub2 := FUZZ_RandomSubgroup( dom, s mod 4 );
                    else  sub2 := sub1 ^ c;  fi;
    # fresh copies, so that nothing computed for sub1 is reused for sub2
    sub1 := Group( GeneratorsOfGroup( sub1 ), () );
    sub2 := Group( GeneratorsOfGroup( sub2 ), () );
    x := Random( sym );
    y := Random( sym );
    z := x * ( o + n, o + n + 1 );        # moves a point outside <dom>
    A := Set( List( [ 1 .. Random( [ 0 .. n ] ) ], i -> Random( dom ) ) );
    if s mod 5 = 0  then  B := Set( List( A, a -> Random( dom ) ) );
                    else  B := OnSets( A, Random( sym ) );  fi;

    # all elements of the symmetric group, for the brute force comparison
    if n <= 7  then  all := AsList( sym );
               else  all := fail;         fi;
    oracle := function( f )
        if all = fail  then  return fail;  fi;
        return f( all );
    end;

    r := ConjugatorPermGroup( sym, sub1, sub2 );
    FUZZ_Check( tag, "conj", r = fail or ( r in sym and sub1 ^ r = sub2 ),
                r = fail,
                oracle( all -> ForAll( all, g -> sub1 ^ g <> sub2 ) ) );
    r := ConjugatorPermGroup( sym, sub1, sub2, sub1, sub2 );
    FUZZ_Check( tag, "conj-with-subgroups",
                r = fail or ( r in sym and sub1 ^ r = sub2 ), r = fail,
                oracle( all -> ForAll( all, g -> sub1 ^ g <> sub2 ) ) );
    N := NormalizerPermGroup( sym, Group( GeneratorsOfGroup( sub1 ), () ) );
    FUZZ_Check( tag, "norm",
                ForAll( GeneratorsOfGroup( N ),
                        g -> g in sym and sub1 ^ g = sub1 ),
                Size( N ),
                oracle( all -> Number( all, g -> sub1 ^ g = sub1 ) ) );
    C := RepOpElmTuplesPermGroup( false, sym, [ x ], [ x ], triv, triv );
    FUZZ_Check( tag, "cent", ForAll( GeneratorsOfGroup( C ), g -> x ^ g = x ),
                Size( C ), oracle( all -> Number( all, g -> x ^ g = x ) ) );
    C := RepOpElmTuplesPermGroup( false, sym, [ x ], [ x ],
                                  Group( x, () ), Group( x, () ) );
    FUZZ_Check( tag, "cent-with-subgroup",
                ForAll( GeneratorsOfGroup( C ), g -> x ^ g = x ),
                Size( C ), oracle( all -> Number( all, g -> x ^ g = x ) ) );
    C := RepOpElmTuplesPermGroup( false, sym, [ x, y ], [ x, y ], triv, triv );
    FUZZ_Check( tag, "cent-pair",
                ForAll( GeneratorsOfGroup( C ), g -> x ^ g = x and y ^ g = y ),
                Size( C ),
                oracle( all -> Number( all, g -> x ^ g = x and y ^ g = y ) ) );
    C := RepOpElmTuplesPermGroup( false, sym, [ z ], [ z ], triv, triv );
    FUZZ_Check( tag, "cent-outside",
                ForAll( GeneratorsOfGroup( C ), g -> g in sym and z ^ g = z ),
                Size( C ), oracle( all -> Number( all, g -> z ^ g = z ) ) );
    r := RepOpElmTuplesPermGroup( true, sym, [ x, y ], [ x ^ c, y ^ c ],
                                  triv, triv );
    FUZZ_Check( tag, "pair-conj",
                r <> fail and x ^ r = x ^ c and y ^ r = y ^ c,
                r = fail, false );
    r := RepOpElmTuplesPermGroup( true, sym, [ x, y ], [ x ^ c, ( y * x ) ^ c ],
                                  triv, triv );
    FUZZ_Check( tag, "pair-conj-2",
                r = fail or ( r in sym and x ^ r = x ^ c
                              and y ^ r = ( y * x ) ^ c ),
                r = fail,
                oracle( all -> ForAll( all, g -> x ^ g <> x ^ c
                                            or y ^ g <> ( y * x ) ^ c ) ) );
    r := RepOpElmTuplesPermGroup( true, sym, [ z ], [ z ^ c ], triv, triv );
    FUZZ_Check( tag, "conj-outside", r = fail or ( r in sym and z ^ r = z ^ c ),
                r = fail, oracle( all -> ForAll( all, g -> z ^ g <> z ^ c ) ) );

    # the property searches have no refinements, so keep them small
    if n <= 8  then
        S := SubgroupProperty( sym, g -> OnSets( A, g ) = A );
        FUZZ_Check( tag, "subgroup-property",
                    ForAll( GeneratorsOfGroup( S ), g -> OnSets( A, g ) = A ),
                    Size( S ),
                    oracle( all -> Number( all, g -> OnSets( A, g ) = A ) ) );
        S := SubgroupProperty( sym, g -> x ^ g = x, Group( x, () ) );
        FUZZ_Check( tag, "subgroup-property-with-subgroup",
                    ForAll( GeneratorsOfGroup( S ), g -> x ^ g = x ),
                    Size( S ), oracle( all -> Number( all, g -> x ^ g = x ) ) );
        r := ElementProperty( sym, g -> OnSets( A, g ) = B );
        FUZZ_Check( tag, "element-property", r = fail or OnSets( A, r ) = B,
                    r = fail,
                    oracle( all -> ForAll( all, g -> OnSets( A, g ) <> B ) ) );
    fi;
end;

for n  in degs  do  for o  in offs  do  for s  in seeds  do
    FUZZ_Round( n, o, s );
od;  od;  od;

Print( FUZZ_tests, " tests, ", FUZZ_failures, " failures\n" );
if FUZZ_failures > 0  then  QuitGap( 1 );  else  QuitGap( 0 );  fi;
