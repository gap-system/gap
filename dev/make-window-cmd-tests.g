# Regenerate tst/testspecial/window-cmd*.g.  Run from the GAP root directory:
#
#   ./gap -A -q dev/make-window-cmd-tests.g
#   (cd tst/testspecial && ./regenerate_tests.sh)
#
# tst/testspecial/README.md describes the answer format.  The answers are
# generated because a miscounted length need not fail visibly.

# every number is written least significant digit first
WCRev := n -> Reversed(String(n));;

# '@' is doubled, a control character becomes '@' and its letter
WCEsc := function(str)
  local out, c;
  out := "";
  for c in str do
    if c = '@' then
      Append(out, "@@");
    elif INT_CHAR(c) in [1..26] then
      Append(out, [ '@', CHAR_INT(INT_CHAR(c) + INT_CHAR('A') - 1) ]);
    else
      Add(out, c);
    fi;
  od;
  return out;
end;;

WCInt := function(n)
  if n < 0 then
    return Concatenation("I", WCRev(-n), "-");
  fi;
  return Concatenation("I", WCRev(n), "+");
end;;

# the length of a string is its un-escaped length
WCStr := s -> Concatenation("S", WCRev(Length(s)), "+", WCEsc(s));;

# the length of an answer is its escaped length
WCAnswer := function(entries)
  local payload;
  payload := Concatenation(entries);
  return Concatenation("got := WindowCmd([\"TST\"]);;\n",
                       "@a", WCRev(Length(payload)), "+", payload, "\n");
end;;

WCShow := {name, show} ->
  Concatenation("Print(\"", name, " = \", ", show, ", \"\\n\");\n");;

# 'PrintTo' would wrap the long answer lines
WCWrite := function(name, str)
  local out;
  out := OutputTextFile(name, false);
  WriteAll(out, str);
  CloseStream(out);
end;;

header := Concatenation(
  "#GAPOPTS -p\n",
  "#  Generated by dev/make-window-cmd-tests.g, see README.md.\n",
  "BreakOnError := false;;\n");;

ok := WCInt(0);;        # the status entry, which 'WindowCmd' removes
long := "Concatenation(ListWithIdenticalEntries(1000, \"@ab\\ncdefg\"))";;

# [ name, entries, expression to print ]; without the latter, an error case
cases := [
  [ "implicit zero", [ ok, "I+" ], "got" ],
  [ "signed integers", [ ok, WCInt(-13), WCInt(7), WCInt(0) ], "got" ],
  [ "empty strings", [ ok, "S+", "S0+" ], "got" ],
  [ "escape table", [ ok, WCStr(List([1..26], CHAR_INT)) ],
    "List(got[1], INT_CHAR)" ],
  [ "mixed entries",
    [ ok, WCStr("a@b"), WCInt(-1), WCStr(""), WCStr("x\ny") ], "got" ],
  # '@' followed by neither '@' nor a capital letter is dropped
  [ "malformed escape", [ ok, "S4+ab@1cd", "S1+a@" ], "got" ],
  # more than the 8000 bytes that answers used to be limited to
  [ "long string", [ ok, WCStr(EvalString(long)) ],
    Concatenation("got = [ ", long, " ]") ],
  [ "unknown entry", [ ok, "Xjunk" ] ],
  [ "string exceeds answer", [ ok, "S0009+0123456789" ] ],
  [ "number too large", [ ok, "I", ListWithIdenticalEntries(20, '9'), "+" ] ],
  [ "status 1", [ WCInt(1), WCStr("bad news") ] ],
];;

test := ShallowCopy(header);;
for c in cases do
  Append(test, WCAnswer(c[2]));
  if IsBound(c[3]) then
    Append(test, WCShow(c[1], c[3]));
  fi;
od;

# the newline fails the header check, so nothing is left in the input
Append(test, "got := WindowCmd([\"TST\"]);;\n@a\n");
Append(test, WCAnswer([ ok, WCStr("ok") ]));
Append(test, WCShow("in sync after errors", "got"));
WCWrite("tst/testspecial/window-cmd.g", test);

# The input ends inside the answer, which also swallows the 'QUIT;' that
# run_gap.sh appends, so this has to be a test of its own.
WCWrite("tst/testspecial/window-cmd-eof.g", Concatenation(header,
  "got := WindowCmd([\"TST\"]);;\n@a", WCRev(5000), "+", ok, "S4+abcd\n"));

QUIT_GAP();
