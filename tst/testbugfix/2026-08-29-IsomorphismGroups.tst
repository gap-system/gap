gap> G1:=Group(gens1);; G2:=Group(gens2);;

# Before the fix this failed for i=3. The earlier iterations are needed:
# they store attribute values in G1 and G2 that influence the later ones.
gap> for i in [1..3] do
>   Reset(GlobalMersenneTwister,i); Reset(GlobalRandomSource,i);
>   if IsomorphismGroups(G1,G2)=fail then
>     Print("wrong fail for seed ",i,"\n");
>   fi;
> od;

#
gap> STOP_TEST("2026-08-29-IsomorphismGroups.tst");
