# IsomorphismGroups returned fail for isomorphic groups for some random
# states: an automorphism found by random search need not stabilize the
# normal subgroup classes used to restrict the lifting search, so the
# known subgroup was not contained in the search space, invalidating the
# backtrack. See https://github.com/gap-system/gap/issues/6537
gap> START_TEST("2026-08-29-IsomorphismGroups.tst");

#
gap> gens1:=[
> (1,4)(2,5)(3,11,10,9,7,8,6,12)(13,16)(14,17)(15,23,22,21,19,20,18,24)
> (27,35,34,33,31,32,30,36)(39,47,46,45,43,44,42,48),
> (1,3,2,4,7,5)(6,11,12,10,8,9)(13,19,17,16,15,14)(18,23,24,22,20,21)
> (25,27,29,28,31,26)(30,32,33,34,35,36)(37,43,38,40,39,41)(42,44,45,46,47,48),
> (1,13,4,16)(2,14,5,17)(3,15,7,19)(6,18,10,22)(8,20,11,23)(9,21,12,24)
> (25,37,28,40)(26,38,29,41)(27,39,31,43)(30,42,34,46)(32,44,35,47)(33,45,36,48),
> (1,7,8)(2,10,12)(3,11,4)(5,6,9)(13,15,23)(14,22,24)(16,19,20)(17,18,21)
> (25,31,35)(26,30,36)(27,32,28)(29,34,33)(37,39,44)(38,42,48)(40,43,47)(41,46,45),
> (1,25)(2,26)(3,27)(4,28)(5,29)(6,30)(7,31)(8,32)(9,33)(10,34)(11,35)(12,36)
> (13,37)(14,38)(15,39)(16,40)(17,41)(18,42)(19,43)(20,44)(21,45)(22,46)(23,47)
> (24,48)];;
gap> gens2:=[
> (1,3,2,4,7,5)(6,11,12,10,8,9)(13,15,14,16,19,17)(18,23,24,22,20,21)
> (25,27,29,28,31,26)(30,32,36,34,35,33)(37,39,41,40,43,38)(42,44,48,46,47,45),
> (1,13,4,16)(2,14,5,17)(3,15,7,19)(6,18,10,22)(8,20,11,23)(9,21,12,24)
> (25,40,28,37)(26,41,29,38)(27,43,31,39)(30,46,34,42)(32,47,35,44)(33,48,36,45),
> (1,25,4,28)(2,26,5,29)(3,27,7,31)(6,30,10,34)(8,32,11,35)(9,33,12,36)
> (13,37,16,40)(14,38,17,41)(15,39,19,43)(18,42,22,46)(20,44,23,47)(21,45,24,48),
> (1,7,8)(2,10,12)(3,11,4)(5,6,9)(13,19,20)(14,22,24)(15,23,16)(17,18,21)
> (25,35,27)(26,33,34)(28,32,31)(29,36,30)(37,47,39)(38,45,46)(40,44,43)(41,48,42),
> (1,48)(2,47)(3,46)(4,45)(5,44)(6,39)(7,42)(8,38)(9,37)(10,43)(11,41)(12,40)
