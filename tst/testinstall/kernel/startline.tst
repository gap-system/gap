#
# Tests for locating the definitions of kernel functions in the C sources.
#
# `STARTLINE_FUNC` scans the C source file recorded in a kernel function's
# handler cookie for the definition of the C function implementing it. The
# tests below check this against all kernel functions GAP knows about, by
# independently verifying that the reported line really is the one on which
# that C function is defined.
#
#@local Sources, cache, funcs, nam, val, sym
#@local resolved, unresolved, mentionedBefore, misreported
gap> START_TEST("kernel/startline.tst");

# Return the lines of a kernel source file, or `fail` if it is not available,
# e.g. when testing an installed GAP shipped without its sources.
gap> cache := rec();;
gap> Sources := function(file)
>      local path, key;
>      key := ReplacedString(ReplacedString(file, "/", "_"), ".", "_");
>      if not IsBound(cache.(key)) then
>        path := Filename(List(GAPInfo.RootPaths, Directory), file);
>        if path = fail or not IsReadableFile(path) then
>          cache.(key) := fail;
>        else
>          cache.(key) := SplitString(StringFile(path), "\n", "");
>        fi;
>      fi;
>      return cache.(key);
>    end;;

# Collect all kernel functions for which we know the name of the C function
# implementing them, as triples [ function, C function name, file name ].
gap> funcs := [];;
gap> for nam in NamesGVars() do
>      if not IsBoundGlobal(nam) then continue; fi;
>      val := ValueGlobal(nam);
>      if not IsFunction(val) then continue; fi;
>      sym := LOCATION_FUNC(val);
>      if sym <> fail then
>        Add(funcs, [val, sym, FilenameFunc(val)]);
>      fi;
>    od;
gap> Length(funcs) > 500;
true

# Each of them records a readable C or C++ source file.
gap> ForAll(funcs, f -> EndsWith(f[3], ".c") or EndsWith(f[3], ".cc"));
true
gap> ForAll(funcs, f -> Sources(f[3]) <> fail);
true

#
gap> resolved := Filtered(funcs, f -> StartlineFunc(f[1]) <> fail);;
gap> unresolved := Filtered(funcs, f -> StartlineFunc(f[1]) = fail);;
gap> Length(resolved) > 500;
true

# The reported line must start the definition of the C function, i.e. it
# consists of the function's name, optionally preceded by its return type.
gap> misreported := Filtered(resolved, function(f)
>      local text;
>      text := Sources(f[3])[StartlineFunc(f[1])];
>      if StartsWith(text, "static ") then
>        text := text{[8 .. Length(text)]};
>      fi;
>      if StartsWith(text, "Obj ") then
>        text := text{[5 .. Length(text)]};
>      fi;
>      return not StartsWith(text, f[2]);
>    end);;
gap> List(misreported, f -> [f[3], StartlineFunc(f[1]), f[2]]);
[  ]

# Distinct C functions must be reported at distinct lines.
gap> Length(Set(resolved, f -> [f[3], StartlineFunc(f[1])]))
>      = Length(Set(resolved, f -> [f[3], f[2]]));
true

# The name of a kernel function commonly also occurs before its definition: in
# the `*F  FuncFOO( ... )` comment blocks preceding many kernel functions, in a
# forward declaration, or in a call. Verify that this is indeed widespread, so
# that the check above is meaningful.
gap> mentionedBefore := Filtered(resolved, function(f)
>      local src, i;
>      src := Sources(f[3]);
>      return ForAny([1 .. StartlineFunc(f[1]) - 1],
>                    i -> PositionSublist(src[i], f[2]) <> fail);
>    end);;
gap> Length(mentionedBefore) > 100;
true

# The functions we cannot locate are those generated by C macros, such as the
# ones `MAKEMATHPRIMITIVE` produces in `src/macfloat.c`. Their names never
# appear in the source outside of comments, so there is nothing to find. For
# those, `LocationFunc` falls back to naming the C function implementing them
# instead of giving a line number.
gap> ForAll(unresolved, function(f)
>      local hits;
>      hits := Filtered(Sources(f[3]),
>                       l -> PositionSublist(l, f[2]) <> fail);
>      return ForAll(hits, l -> StartsWith(l, "*") or StartsWith(l, "//"));
>    end);
true
gap> ForAll(unresolved,
>           f -> LocationFunc(f[1]) = Concatenation(f[3], ":", f[2]));
true

#
gap> STOP_TEST("kernel/startline.tst");
