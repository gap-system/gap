#@local m, G
gap> START_TEST( "FieldOfMatrixList.tst" );

#
# matrix objects, via the generic method
#
gap> m:= Matrix( IsPlistMatrixRep, Rationals, [ [ 1, 2 ], [ 3, 4 ] ] );;
gap> FieldOfMatrixList( [ m ] );
Rationals
gap> m:= Matrix( IsPlistMatrixRep, GaussianRationals, [ [ 1, 2 ], [ 3, E(4) ] ] );;
gap> FieldOfMatrixList( [ m ] );
GaussianRationals

# the base domain, even though the entries generate a smaller field
gap> m:= Matrix( IsPlistMatrixRep, GaussianRationals, [ [ 1, 2 ], [ 3, 4 ] ] );;
gap> FieldOfMatrixList( [ m ] );
GaussianRationals

# matrices that are lists keep the "field generated by the entries" meaning
gap> FieldOfMatrixList( [ [ [ 1, 2 ], [ 3, 4 ] ] ] );
Rationals
gap> FieldOfMatrixList( [ ImmutableMatrix( GF(4), [ [ Z(2)^0 ] ] ) ] );
GF(2)
gap> FieldOfMatrixList( [ Matrix( IsPlistMatrixRep, GF(4), [ [ Z(2)^0 ] ] ) ] );
GF(2^2)

#
# and the matrix group attributes built on it
#
gap> G:= Group( Matrix( IsPlistMatrixRep, Rationals, [ [ 1, 1 ], [ 0, 1 ] ] ) );;
gap> FieldOfMatrixGroup( G );
Rationals
gap> DefaultFieldOfMatrixGroup( G );
Cyclotomics

#
# matrix objects over a finite field still take the fast path
#
gap> FieldOfMatrixList( [ Matrix( IsPlistMatrixRep, GF(4), [ [ Z(4) ] ] ) ] );
GF(2^2)

#
# a non-matrix is still rejected
#
gap> FieldOfMatrixList( [ [ 1, 2 ] ] );
Error, <l> must be a nonempty list of matrices or matrix objects
gap> FieldOfMatrixList( [] );
Error, <l> must be a nonempty list of matrices or matrix objects

#
gap> STOP_TEST( "FieldOfMatrixList.tst" );
