gap> #GAPOPTS -E --readline --minworkspace 300m --maxworkspace 600m --limitworkspace 1g
gap> # the kernel must honour the long forms of its options
gap> GAPInfo.KernelInfo.HAVE_LIBREADLINE;
true
gap> l := GASMAN_LIMITS();;
gap> expected := [ 300, 600, 1024 ] * 1024;;
gap> ForAll( [ 1 .. 3 ], i -> not IsBound( l[i] ) or l[i] = expected[i] );
true
gap> QUIT;
